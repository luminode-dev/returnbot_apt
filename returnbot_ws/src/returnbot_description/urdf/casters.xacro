<?xml version="1.0"?>
<!--
  후방 캐스터 2개.

  ┌─ 근사임을 명시한다 (명세 Phase 1 요구사항) ────────────────────────────┐
  │ 실물은 스위블(자유회전) 캐스터지만 여기서는 조인트 없는 저마찰 구(sphere)로  │
  │ 근사한다. 스위블 축의 회전 저항 — 정지 상태에서 바퀴가 진행방향으로 틀어질   │
  │ 때 생기는 저항 — 을 모사하지 못한다.                                    │
  │                                                                        │
  │ 이 저항이 명세 §1의 검증항목 3 "피벗턴 시 캐스터 저항에 의한 경로 밀림"의   │
  │ 원인이므로, 구형 근사만으로는 그 현상이 재현되지 않는다. 등가 마찰계수      │
  │ (caster_mu)로 크기만 흉내낸다.                                          │
  │                                                                        │
  │ 명세 §8의 리스크 항목대로 Phase 4에서 조인트 기반 캐스터(스위블축           │
  │ continuous 조인트 + 오프셋 포크 + 회전축 damping)로 상세화를 검토한다.      │
  └────────────────────────────────────────────────────────────────────────┘

  참고: 바닥 이격(ground_clearance 0.04)이 캐스터 지름(0.1)보다 작아 구의 위쪽
  절반이 차체 박스 안에 묻힌다. 실물의 캐스터 브래킷 리세스에 해당하며,
  같은 링크 트리에 속하므로 자기충돌 문제는 없다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- side: 'left' | 'right', reflect: +1 | -1 -->
  <xacro:macro name="caster" params="side reflect">
    <joint name="${side}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_caster_link"/>
      <!-- 후방(-x), 지면에 닿도록 z 는 caster_radius - wheel_radius -->
      <origin xyz="${-wheelbase} ${reflect * caster_separation / 2.0} ${caster_radius - wheel_radius}"
              rpy="0 0 0"/>
    </joint>

    <link name="${side}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="returnbot_caster"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>

      <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>
  </xacro:macro>

  <xacro:caster side="left"  reflect="1"/>
  <xacro:caster side="right" reflect="-1"/>

</robot>
