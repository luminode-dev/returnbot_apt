<?xml version="1.0"?>
<!--
  차체 치수 파라미터.

  기본값은 config/robot_dimensions.yaml 과 반드시 일치해야 한다.
  tests/test_urdf_params.py 가 두 파일이 갈라지지 않았는지 검사한다.

  ${$(arg x)} 형태로 감싸는 이유: $(arg ...) 치환 결과는 문자열이라
  그대로 산술에 쓰면 타입 오류가 난다. ${} 로 한 번 평가해 float로 만든다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ 노출 인자 ==
       Phase 3 매트릭스 실험(차체폭 550/600/650 × 복도 유형)이 이 인자들만
       바꿔서 돌아가야 한다 (명세 Phase 1 완료 기준).
  -->
  <xacro:arg name="wheel_separation" default="0.45"/>
  <xacro:arg name="body_width"       default="0.55"/>
  <xacro:arg name="body_depth"       default="0.7"/>
  <xacro:arg name="body_height"      default="0.4"/>
  <xacro:arg name="wheel_radius"     default="0.1"/>
  <xacro:arg name="wheelbase"        default="0.4"/>
  <xacro:arg name="total_mass"       default="60.0"/>

  <xacro:property name="wheel_separation" value="${$(arg wheel_separation)}"/>
  <xacro:property name="body_width"       value="${$(arg body_width)}"/>
  <xacro:property name="body_depth"       value="${$(arg body_depth)}"/>
  <xacro:property name="body_height"      value="${$(arg body_height)}"/>
  <xacro:property name="wheel_radius"     value="${$(arg wheel_radius)}"/>
  <xacro:property name="wheelbase"        value="${$(arg wheelbase)}"/>
  <xacro:property name="total_mass"       value="${$(arg total_mass)}"/>

  <!-- =========================================================== 고정 치수 == -->
  <!-- 명세 §3 확정값 -->
  <xacro:property name="wheel_width"      value="0.05"/>
  <xacro:property name="caster_radius"    value="0.05"/>
  <xacro:property name="drive_load_ratio" value="0.6"/>

  <!-- TODO(확인) 명세 미기재. config/robot_dimensions.yaml 참조 -->
  <xacro:property name="caster_separation" value="0.4"/>
  <xacro:property name="ground_clearance"  value="0.04"/>
  <xacro:property name="wheel_mass"        value="2.5"/>
  <xacro:property name="caster_mass"       value="0.8"/>

  <!-- 센서. TODO(확인) 전부 데이터시트 확인 필요 -->
  <xacro:property name="lidar_size_x"      value="0.06"/>
  <xacro:property name="lidar_size_y"      value="0.06"/>
  <xacro:property name="lidar_size_z"      value="0.04"/>
  <xacro:property name="lidar_mass"        value="0.2"/>
  <xacro:property name="imu_size_x"        value="0.02"/>
  <xacro:property name="imu_size_y"        value="0.02"/>
  <xacro:property name="imu_size_z"        value="0.005"/>
  <xacro:property name="imu_mass"          value="0.02"/>
  <xacro:property name="camera_size_x"     value="0.03"/>
  <xacro:property name="camera_size_y"     value="0.09"/>
  <xacro:property name="camera_size_z"     value="0.025"/>
  <xacro:property name="camera_mass"       value="0.08"/>
  <xacro:property name="camera_mount_height" value="0.3"/>

  <!-- 마찰. 명세 §8 - 시뮬 튜닝 시작점일 뿐이다 -->
  <xacro:property name="drive_wheel_mu"    value="1.0"/>
  <xacro:property name="caster_mu"         value="0.05"/>

  <!-- ============================================================ 파생 치수 ==

       base_link 원점 = 구동축 중심, 높이는 바퀴 반경(=구동륜 축 높이).
       캐스터는 후방이므로 x = -wheelbase.

       무게배분(명세 §3, 구동축:캐스터 = 60:40)은 차체 질량중심의 x 위치로 구현한다.

       지지점은 구동축(x=0)과 캐스터축(x=-wheelbase) 두 곳이다. 정역학에서
       캐스터 하중비는 전체 질량중심 위치로만 결정되므로, 목표는

           x_com_total = -(1 - drive_load_ratio) * wheelbase

       각 링크의 기여를 모으면 (바퀴는 x=0 이라 기여 0):

           (m_chassis + m_sensors) * c
             + m_camera * (카메라의 차체중심 대비 전방 오프셋)
             - m_caster_total * wheelbase
           = total_mass * x_com_total

       LiDAR·IMU 는 차체 중심 x 에 얹혀 있어 c 와 같이 움직이지만, 전방 카메라만
       고정 오프셋을 갖는다. 이 항을 빼먹으면 하중비가 실제로 60:40 이 되지 않는다.
       상수를 직접 적지 않고 비율에서 역산하므로 질량·배분비·치수를 바꿔도 따라간다.
  -->
  <xacro:property name="wheel_mass_total"  value="${2 * wheel_mass}"/>
  <xacro:property name="caster_mass_total" value="${2 * caster_mass}"/>
  <xacro:property name="sensor_mass_total" value="${lidar_mass + imu_mass + camera_mass}"/>
  <xacro:property name="chassis_mass"
                  value="${total_mass - wheel_mass_total - caster_mass_total - sensor_mass_total}"/>

  <!-- 카메라의 차체 기하중심 대비 전방 오프셋 -->
  <xacro:property name="camera_forward_offset" value="${body_depth/2.0 + camera_size_x/2.0}"/>
  <xacro:property name="body_group_mass" value="${chassis_mass + sensor_mass_total}"/>
  <xacro:property name="chassis_com_x"
                  value="${(caster_mass_total * wheelbase
                            - (1.0 - drive_load_ratio) * total_mass * wheelbase
                            - camera_mass * camera_forward_offset) / body_group_mass}"/>

  <!-- body_height 는 명세 §3의 차체 외형 전고(400mm)다. 실제 박스는 바닥
       이격(ground_clearance)만큼 얇아진다. -->
  <xacro:property name="box_height" value="${body_height - ground_clearance}"/>

  <!-- 차체 박스 중심. 박스는 균질이라 기하 중심 = 질량중심이다.
       z 는 base_link(=구동축 높이 wheel_radius) 기준 상대값. -->
  <xacro:property name="body_center_x" value="${chassis_com_x}"/>
  <xacro:property name="body_center_z" value="${ground_clearance + box_height/2.0 - wheel_radius}"/>
  <xacro:property name="body_top_z"    value="${body_height - wheel_radius}"/>
  <xacro:property name="body_front_x"  value="${body_center_x + body_depth/2.0}"/>

</robot>
